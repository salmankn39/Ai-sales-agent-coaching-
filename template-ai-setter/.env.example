# ── REQUIRED — the app will not run without these ──────────────────────────

# Supabase (your database) → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Some modules read this older name — set it to the SAME value as above.
SUPABASE_SERVICE_KEY=

# Anthropic (the AI brain) → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Which clients row is YOURS (your default setter). Pick once, keep forever.
# Lowercase letters and hyphens only, e.g. "my-agency".
DEFAULT_CLIENT_SLUG=

# Your app's own public URL, once Vercel gives you one (no trailing slash),
# e.g. https://my-setter.vercel.app
NEXT_PUBLIC_BASE_URL=

# Any long random string. Protects your dashboard login sessions.
SESSION_SECRET=

# ── ALSO REQUIRED: your phone control ──────────────────────────────────────

# Telegram: pings TO you (stand-downs, stuck handoffs, booked calls) AND
# texting your setter to control it. @BotFather → /newbot → token.
# @userinfobot → your numeric id. Open your bot and press START.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string you invent. Telegram sends it back on every message
# so your app knows the message is genuinely from Telegram and not a stranger
# who found your URL. Nothing works over Telegram without it.
TELEGRAM_WEBHOOK_SECRET=

# ── STRONGLY RECOMMENDED ───────────────────────────────────────────────────

# Any long random string. Lets you protect the cron endpoints.
CRON_SECRET=

# ── OPTIONAL — each unlocks one feature, blank = feature off ───────────────

# Voice notes in your cloned voice (elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Transcribing leads' Instagram voice notes (console.groq.com, free tier)
GROQ_API_KEY=

# GoHighLevel CRM sync. OPTIONAL: the setter works fully without GHL, and the
# kit connects Instagram through ManyChat instead. A client's GHL keys live on
# their row in the database, not here.
# Only if you connect GHL: YOUR AI sales pipeline id (GHL → Opportunities →
# open the pipeline → it is in the address bar). Leave blank otherwise.
GHL_PIPELINE_ID=

# Your timezone, so "today" on the dashboard means today where you are.
# Examples: America/New_York, Europe/London, Australia/Sydney. Blank = UTC.
BUSINESS_TIMEZONE=

# Web research inside HQ chat (tavily.com)
TAVILY_API_KEY=
